anova_results <- aov_ez("participant", "Agreement", tidy_df, between = "group", within = "subscale", detailed = TRUE)
tidy_df$unique_id <- interaction(tidy_df$group, tidy_df$participant)
# Run a mixed ANOVA
anova_results <- aov_ez("unique_id", "Agreement", tidy_df, between = "group", within = "subscale", detailed = TRUE)
# Get the summary of the ANOVA
summary(anova_results)
