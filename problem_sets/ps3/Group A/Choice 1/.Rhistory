# Assuming your data frame is named 'tidy_df' and is structured appropriately
# with 'participant' as a factor indicating individual participants,
# 'group' as a between-subjects factor, and 'subscale' as a within-subjects factor
# Run a mixed ANOVA
anova_results <- aov_ez("participant", "Agreement", tidy_df, between = "group", within = "subscale", detailed = TRUE)
# #optional packages/functions:
library(afex) # anova functions
# Assuming your data frame is named 'tidy_df' and is structured appropriately
# with 'participant' as a factor indicating individual participants,
# 'group' as a between-subjects factor, and 'subscale' as a within-subjects factor
