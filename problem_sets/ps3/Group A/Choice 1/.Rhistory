# Just Experiment 2
data_path <- 'data/DeLaFuenteEtAl_2014_RawData.xls'
d <- read_excel(data_path, sheet=3)
print(head(d))
View(d)
View(d)
tidy_df <- d %>%
group_by(group, participant) %>%
spread(key = subscale, value = Agreement) %>%
ungroup()
tidy_df <- d %>%
rename(Agreement = `Agreement (0=complete disagreement; 5=complete agreement)`)
group_by(group, participant) %>%
spread(key = subscale, value = Agreement) %>%
ungroup()
tidy_df <- d %>%
rename(Agreement = `Agreement (0=complete disagreement; 5=complete agreement)`) %>%
group_by(group, participant) %>%
spread(key = subscale, value = Agreement) %>%
ungroup()
print(head(tidy_df))
tidy_df <- d %>%
rename(Agreement = `Agreement (0=complete disagreement; 5=complete agreement)`)
print(head(tidy_df))
View(tidy_df)
library(ggplot2)
# Calculate mean and standard error
summary_df <- tidy_df %>%
group_by(group, subscale) %>%
summarise(
mean = mean(Agreement, na.rm = TRUE),
sd = sd(Agreement, na.rm = TRUE),
se = sd / sqrt(n())
) %>%
ungroup()
# Create the plot
ggplot(summary_df, aes(x = group, y = mean, fill = subscale)) +
geom_bar(stat = "identity", position = position_dodge(width = 0.7), width = 0.6) +
geom_errorbar(aes(ymin = mean - se, ymax = mean + se),
position = position_dodge(width = 0.7), width = 0.25) +
labs(x = "", y = "Rating") +
scale_fill_grey(start = 0.8, end = 0.5) + # Assuming black and white color scheme as in the figure
theme_minimal() +
theme(legend.title = element_blank(),
legend.position = "top",
axis.text.x = element_text(angle = 45, hjust = 1),
plot.title = element_text(hjust = 0.5)) +
ggtitle("Figure 2. Results of Experiment 2")
